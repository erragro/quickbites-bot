DATABASE_URL=postgresql+psycopg://quickbites:quickbites@localhost:5432/quickbites

# Provider selection: "gemini_gateway" (default) or "anthropic"
LLM_PROVIDER=gemini_gateway

# Gemini Gateway (default)
GEMINI_GATEWAY_URL=https://gemini-gateway-162392320588.asia-south1.run.app
GEMINI_GATEWAY_SECRET=gw-...
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_SMART_MODEL=gemini-2.5-flash

# Anthropic (only required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

SIMULATOR_BASE_URL=https://quickbites-simulator.example.com
CANDIDATE_TOKEN=replace-me
