DATABASE_URL=postgresql+psycopg://quickbites:quickbites@localhost:5432/quickbites

# Provider routing is automatic, by detected language — no manual toggle.
# en/hi -> Gemini via Vertex AI; everything else -> Sarvam AI.

# Gemini via Vertex AI, direct (en, hi). Project must have Vertex AI
# enabled + active billing. Auth: set GOOGLE_APPLICATION_CREDENTIALS to a
# service-account key file (role: Vertex AI User), or use
# `gcloud auth application-default login` for local dev.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_SMART_MODEL=gemini-2.5-flash

# Sarvam AI (all other Indian languages)
SARVAM_API_KEY=
SARVAM_FAST_MODEL=sarvam-30b
SARVAM_SMART_MODEL=sarvam-105b

# Google Cloud Translation API v2 (Basic) — language detection only
GOOGLE_TRANSLATE_API_KEY=

SIMULATOR_BASE_URL=https://quickbites-simulator.example.com
CANDIDATE_TOKEN=replace-me
